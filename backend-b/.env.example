# ── Chain RPCs ──────────────────────────────────────────────────────────────────
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
MONAD_MAINNET_RPC=https://rpc.monad.xyz
LOCAL_RPC=http://127.0.0.1:8545

# ── Backend B — operator keys (one per chain) ─────────────────────────────────
OPERATOR_PRIVATE_KEY_LOCAL=0x<anvil-key-1>
OPERATOR_PRIVATE_KEY_TESTNET=0x<testnet-operator-private-key>
OPERATOR_PRIVATE_KEY_MAINNET=0x<mainnet-operator-private-key>

# ── Backend B — services ──────────────────────────────────────────────────────
PORT=8787
MONGODB_URI=mongodb://127.0.0.1:27017/scanpay
PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
ENABLED_CHAINS=31337
ADMIN_TOKEN=<openssl rand -hex 16>
LOG_LEVEL=info
ATTACK_LAB_ENABLED=true

# ── External providers ────────────────────────────────────────────────────────
AURORA_API_KEY=
ONECLICK_JWT=
ENVIO_GRAPHQL_URL=http://localhost:8080/v1/graphql

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_RP_ID=localhost
NEXT_PUBLIC_RP_NAME=ScanPay
NEXT_PUBLIC_DEFAULT_CHAIN_ID=31337
NEXT_PUBLIC_RPC_10143=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_RPC_143=https://rpc.monad.xyz
