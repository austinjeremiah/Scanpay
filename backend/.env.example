# ScanPay Guard — Backend A (contracts) env template
# Copy to backend/.env and fill. NEVER commit backend/.env (already gitignored).
# A18 (local anvil) needs NONE of this. First needed at A19 (testnet).

# ---------------------------------------------------------------------------
# 1. ADDRESSES  (public — safe to share, safe to commit to .env.example)
# ---------------------------------------------------------------------------
# Your testing wallet. Same address works on BOTH chains (10143 + 143).
# Gets DEFAULT_ADMIN_ROLE + CONFIG_ROLE + PAUSER_ROLE on the vault and registry.
ADMIN_ADDRESS=0x

# Where the 0.30% protocol fee lands. Same wallet is fine for the hackathon.
FEE_RECIPIENT=0x

# Backend B's relayer wallet — gets VERIFIER_ROLE + ATTESTER_ROLE + MINTER_ROLE.
# B needs this wallet's PRIVATE KEY on their server, so it should NOT be your
# admin wallet on mainnet. If B isn't ready, put your own address here and we
# grantRole/revokeRole to B's later (one cheap tx, no redeploy).
OPERATOR_ADDRESS=0x

# ---------------------------------------------------------------------------
# 2. KEYSTORE  (no private key in this file, ever)
# ---------------------------------------------------------------------------
# Create once:  cast wallet import scanpay-deployer --interactive
# Then forge script uses --account scanpay-deployer and prompts for a password.
DEPLOYER_ACCOUNT=scanpay-deployer

# ---------------------------------------------------------------------------
# 3. CHAINS  (defaults work; override only if a public RPC rate-limits)
# ---------------------------------------------------------------------------
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
MONAD_MAINNET_RPC=https://rpc.monad.xyz

# Optional — only for `forge verify-contract`. Deploy works without it.
MONADSCAN_API_KEY=

# ---------------------------------------------------------------------------
# 4. VAULT CONFIG  (these are the doc's defaults; don't change without reason)
# ---------------------------------------------------------------------------
FEE_BPS=30            # 0.30%, MAX_FEE_BPS is 100 so this cannot exceed 1%
REFUND_DELAY_SEC=600  # 10 min before a stuck cross-chain payment is refundable
