{
  "name": "@scanpay/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../../.env src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:ci": "vitest run test/unit",
    "test:integration": "vitest run test/integration --no-file-parallelism",
    "test:all": "vitest run --no-file-parallelism",
    "test:e2e": "vitest run test/e2e --no-file-parallelism",
    "smoke:mainnet-readonly": "tsx --env-file=../../../.env scripts/smoke-mainnet-readonly.ts",
    "verify-receipt": "tsx --env-file=../../../.env scripts/verify-receipt.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@scanpay/shared": "workspace:*",
    "fastify": "^5.1.0",
    "mongoose": "^8.8.0",
    "pino": "^9.5.0",
    "viem": "^2.40.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "mongodb-memory-server": "^10.1.2",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
